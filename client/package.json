{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development wait-on http://localhost:5173 && electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron:start\"",
    "package": "npm run build && electron-builder build --mac --win"
  },
  "build": {
    "appId": "com.webrtc.meetingclient",
    "productName": "MeetingClient",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg", "dir"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "ビデオ通話のためにカメラへのアクセスが必要です。",
        "NSMicrophoneUsageDescription": "音声通話のためにマイクへのアクセスが必要です。"
      }
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "mediasoup-client": "^3.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
