{
  "name": "checkhouse-meeting-screen-share",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development wait-on http://localhost:5174 && electron .",
    "electron:dev": "concurrently -k \"npm run dev -- --port 5174\" \"npm run electron:start\"",
    "package": "npm run build && electron-builder build --mac --arm64 && electron-builder build --win --x64",
    "package:mac": "npm run build && electron-builder build --mac --arm64",
    "package:win": "npm run build && electron-builder build --win --x64"
  },
  "build": {
    "appId": "com.checkhouse.meeting.screenshare",
    "productName": "CHECKHOUSE Meeting Screen Share",
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "dir"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "画面共有の送信確認にカメラ権限が要求される場合があります。",
        "NSAudioCaptureUsageDescription": "画面共有中にアプリまたはシステム音声を共有するために音声収録へのアクセスが必要です。",
        "NSMicrophoneUsageDescription": "画面共有中の音声送信にマイク権限が要求される場合があります.",
        "NSScreenCaptureDescription": "画面共有のために画面収録へのアクセスが必要です。"
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "mediasoup-client": "^3.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
