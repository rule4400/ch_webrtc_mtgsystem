{
  "name": "checkhouse-meeting-server-gui",
  "version": "1.4.0",
  "description": "CHECKHOUSE Meeting System server controller",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-private-file.cjs && node scripts/test-update-scan.cjs",
    "verify:binary-manifest": "node scripts/verify-binary-manifest.cjs",
    "prepare:resources": "node scripts/prepare-bundled-server.cjs && node scripts/prepare-ffmpeg.cjs",
    "package": "npm run prepare:resources && electron-builder build --mac --arm64 && electron-builder build --win --x64",
    "package:mac": "npm run prepare:resources && electron-builder build --mac --arm64",
    "package:win": "npm run prepare:resources && electron-builder build --win --x64",
    "package:win:arm64": "echo \"Windows arm64 is not packaged because mediasoup-worker win32-arm64 prebuild is unavailable for this mediasoup version.\" && exit 1"
  },
  "build": {
    "appId": "com.checkhouse.meeting.server",
    "productName": "CHECKHOUSE Meeting Server",
    "mac": {
      "icon": "build/icon.icns",
      "target": ["dmg", "dir"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis", "portable", "zip"]
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../server",
        "to": "bundled-server",
        "filter": [
          "index.js",
          "config.js",
          "recording.js",
          "published-files.js",
          "package.json",
          ".env.example",
          "public/**"
        ]
      },
      {
        "from": "resources/mediasoup-workers",
        "to": "mediasoup-workers"
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg"
      }
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mediasoup": "^3.26.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^42.10.1",
    "electron-builder": "^26.15.3"
  }
}
