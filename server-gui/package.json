{
  "name": "sfu-server-gui",
  "version": "1.0.0",
  "description": "GUI Wrapper for WebRTC SFU Server",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder build --mac --arm64 --win --x64",
    "package:mac": "electron-builder build --mac --arm64",
    "package:win": "electron-builder build --win --x64",
    "package:win:arm64": "electron-builder build --win --arm64"
  },
  "build": {
    "appId": "com.webrtc.servergui",
    "productName": "SFU Server GUI",
    "mac": {
      "target": ["dmg", "dir"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^latest",
    "electron-builder": "^latest"
  }
}
