PORT=3000

# VPN内で全クライアントから到達できるSFUサーバーのIPを指定してください。
# 未指定の場合は「非内部IPv4を全て」ICE候補として広告し、各拠点から到達できる
# 経路をICEが自動選択します（多重ホーム/L2・L3混在のVPNで取りこぼしを防ぐ）。
# 拠点間VPNでは到達確実なVPN内IPを明示するのが最も確実です。
ANNOUNCED_IP=

# 追加で広告したいIPがあればカンマ区切りで指定（例: VPN内IPとグローバルIPの併用）。
# ANNOUNCED_IPS=

# ANNOUNCED_IP を明示しても、サーバー機のローカルIPv4も併せて広告したい場合は 1 に。
# ANNOUNCED_ADD_LOCAL=0

# ファイアウォール/VPNでこのUDP/TCP範囲を通してください。
RTC_MIN_PORT=10000
RTC_MAX_PORT=10200

# VPN経由で到達できるならSTUN/TURNは空で成立します。
# 不安定なNAT越えやUDP制限がある場合はTURNを追加してください。
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_USER=turn-user
# TURN_PASS=turn-password

# メディア伝送のTCP設定。UDPが不安定/遮断される環境向け。
# FORCE_TCP=1  … UDPを無効化し、映像・音声・画面共有を全てTCPで伝送
# PREFER_TCP=1 … UDPも有効なままTCP候補を優先
# ※TCPは遅延が増えるため、UDPが通る環境では未設定(UDP優先)のままにすること。
# FORCE_TCP=0
# PREFER_TCP=0

# ビットレート上限(bps)。getServerConfig 経由で全クライアントに配布され、
# クライアント側の画質設定(高/中/低)はこの値への倍率として適用される。
# VIDEO_MAX_BITRATE=1200000
# SCREEN_MAX_BITRATE=1800000
# AUDIO_MAX_BITRATE=0   # 0 = Opus既定値

# 監視GUIへの統計送信間隔(ms)。小さくするほど表示はリアルタイムになるが
# サーバーCPU負荷が増える（既定 500）。
# STATS_INTERVAL_MS=500

# メディアフロー監視: 各拠点の上り(サーバー受信)と下り(サーバー送出)のRTPが
# 実際に流れているかを周期確認し、停滞していればセッションを作り直させる自動復旧機構。
# MEDIA_STALL_RECOVERY=0 で無効化。
# MEDIA_STALL_RECOVERY=1
# 受信バイト数が増えないまま何msで「停滞」と判定するか（既定 15000）
# MEDIA_STALL_RESTART_MS=15000
# 同一拠点への再構築指示のクールダウン（既定 60000）
# MEDIA_STALL_COOLDOWN_MS=60000
# 再構築を何回繰り返しても復旧しなければクライアント再起動へ切替（既定 3）
# MEDIA_STALL_ESCALATE_STRIKES=3
