PORT=3000

# ── 認証・公開範囲 ──
# 全クライアント（会議/画面共有/閲覧）の設定画面に入れる共通トークン。
# 十分長いランダム値を使い、Git・ログ・URLに記録しないでください。
# 例: openssl rand -base64 32
# SFU_AUTH_TOKEN=

# 1にすると、SFU_AUTH_TOKENが未設定な起動をエラーにします。
# 先に全クライアントへトークンを配布してから1にしてください。
# SFU_REQUIRE_AUTH=1

# 録画設定のHTTP変更と /health/details 専用の管理トークン。
# 会議クライアント用SFU_AUTH_TOKENとは別の値にします。未設定時は管理APIを無効化します。
# SFU_ADMIN_TOKEN=

# 過去録画・ライブ視聴専用トークン。通常クライアント用・管理用とは別の値にします。
# 未設定時は録画閲覧を無効化します。
# RECORDING_ACCESS_TOKEN=
# 旧環境で匿名閲覧を一時的に戻す場合だけ明示（本番非推奨）。
# RECORDING_ALLOW_ANONYMOUS=0
# TLS終端の外側からHTTPSで提供する場合は、閲覧session cookieにSecureを付けます。
# RECORDING_COOKIE_SECURE=1
# 閲覧sessionの有効期限(ms、既定8時間、最大24時間)。
# RECORDING_SESSION_TTL_MS=28800000
# ライブ視聴と過去録画配信を合わせた同時stream上限（全体／接続元IPごと）。
# ライブ視聴はローカルstagingを継続読み込みするため、会議優先の既定値から始めます。
# RECORDING_MAX_CONCURRENT_STREAMS=16
# RECORDING_MAX_STREAMS_PER_IP=4
# 録画検索rate limitで同時に追跡する接続元IP数（既定4096、上限到達時は新規IPを429）。
# trusted proxy配下でも送信元アドレスによるmemory増加をこの件数に制限します。
# RECORDING_QUERY_CLIENT_MAX=4096

# browserからのHTTP/Socket.IO接続を許可するOrigin（カンマ区切り）。
# localhostの開発ポートとElectron(file://)は既定で許可されます。
# Originなし/nullはElectron・native client互換のため許可します。Origin制限は
# 認証境界ではないため、本番では必ずSFU_AUTH_TOKEN + SFU_REQUIRE_AUTH=1も有効にします。
# SFU_ALLOWED_ORIGINS=https://meeting.example.jp

# TLS/reverse proxy配下で接続元IP別の上限を正しく適用する場合、実際のproxyの
# IP/CIDRだけを列挙します（例: 127.0.0.1/8,::1/128 または 10.0.0.5/32）。
# 未設定時はX-Forwarded-Forを信頼しません。`true`や全ネットワーク指定は避け、
# サーバー本体への直接接続もfirewallで遮断してください。
# SFU_TRUST_PROXY=

# サーバーは現在HTTPでトークンを送るため、信頼できるVPN内で使うか、
# TLS終端のreverse proxy配下に置いてください。Internetへ3000/tcpを直接公開しません。

# VPN内で全クライアントから到達できるSFUサーバーのIPを指定してください。
# 未指定の場合は「非内部IPv4を全て」ICE候補として広告し、各拠点から到達できる
# 経路をICEが自動選択します（多重ホーム/L2・L3混在のVPNで取りこぼしを防ぐ）。
# 拠点間VPNでは到達確実なVPN内IPを明示するのが最も確実です。
ANNOUNCED_IP=

# 追加で広告したいIPがあればカンマ区切りで指定（例: VPN内IPとグローバルIPの併用）。
# ANNOUNCED_IPS=

# ANNOUNCED_IP を明示しても、サーバー機のローカルIPv4も併せて広告したい場合は 1 に。
# ANNOUNCED_ADD_LOCAL=0

# ファイアウォール/VPNでこのUDP/TCP範囲を通してください。
RTC_MIN_PORT=10000
RTC_MAX_PORT=10200

# メディア固定ポート(推奨・特にUTM/ファイアウォール設置拠点がある場合)。
# 指定すると全クライアントのメディア(UDP/TCP)がこの1ポートに集約され、
# UTM側の許可設定が「サーバーIPの UDP/TCP 10000 のみ」で済む。
# 動的ポート割当が原因の「たまたま通る/通らない」も解消される。
# 未指定なら従来どおり RTC_MIN/MAX_PORT の範囲を使用。
# RTC_PORT=10000

# 追加TCP待受ポート(RTC_PORTと併用、カンマ区切り)。これはSFUへの直接ICE-TCPで、
# HTTPS/TURN-TLSではありません。ポート番号だけでなく通信内容も制限するUTM拠点には、
# 下記の TURN-TLS (turns:...:443?transport=tcp) を併用してください。
# macOS/Windows は管理者権限不要。Linux は 1024未満に CAP_NET_BIND_SERVICE または
# root が必要で、バインド失敗時は追加ポート無しで自動縮退する。
# server-gui の設定タブからも変更可能(保存時に自動再起動で適用)。
# RTC_EXTRA_TCP_PORTS=443

# 拠点単位の自動TCPフォールバック(既定ON)。UTM等でUDPが遮断される拠点を
# 自動検出し、その拠点だけメディアをTCPに切り替える。
#   - DTLS接続要求から30秒(TCP_FALLBACK_CONNECT_MS)確立しない
#   - メディア停滞の復旧が2回(TCP_FALLBACK_AFTER_STRIKES)続く
# 切替は端末単位で6時間(TCP_FALLBACK_TTL_MS)記憶され、期限後はUDPを再試行する。
# MEDIA_TCP_FALLBACK=1
# TCP_FALLBACK_CONNECT_MS=30000
# TCP_FALLBACK_AFTER_STRIKES=2
# TCP_FALLBACK_TTL_MS=21600000

# リソースしきい値監視(ジワジワ型のメモリ/ポート枯渇の予防)。
# メモリが MEM_RESTART_MB を超えると、server-gui等の監視下では予防的に
# プロセスを再起動して回収する(自動再起動で復帰)。0 で無効化。
# MEM_WARN_MB=1200
# MEM_RESTART_MB=2200
# RESOURCE_CHECK_MS=60000

# サーバーの永続状態ファイル(TCPフォールバック記憶など)。server-gui 経由の
# 起動では自動的に userData 配下が使われる。
# SERVER_STATE_FILE=./sfu-state.json

# VPN経由で到達できるならSTUN/TURNは空で成立します。
# 不安定なNAT越えやUDP制限がある場合はTURNを追加してください。
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# TURN_USER=turn-user
# TURN_PASS=turn-password

# メディア伝送のTCP設定。UDPが不安定/遮断される環境向け。
# FORCE_TCP=1  … UDPを無効化し、映像・音声・画面共有を全てTCPで伝送
# PREFER_TCP=1 … UDPも有効なままTCP候補を優先
# ※TCPは遅延が増えるため、UDPが通る環境では未設定(UDP優先)のままにすること。
# FORCE_TCP=0
# PREFER_TCP=0

# ビットレート上限(bps)。getServerConfig 経由で全クライアントに配布され、
# クライアント側の画質設定(高/中/低)はこの値への倍率として適用される。
# VIDEO_MAX_BITRATE=1200000
# SCREEN_MAX_BITRATE=1800000
# AUDIO_MAX_BITRATE=0   # 0 = Opus既定値

# 通知音(着信音)の配布フォルダ。ここに置いた mp3/wav/ogg/m4a を各クライアントが
# 設定画面から取り込んで着信音として使える。server-gui 経由の起動では自動的に
# userData 配下が使われ、サーバー更新後もファイルが引き継がれる。
# RINGTONES_DIR=./ringtones

# 監視GUIへの統計送信間隔(ms)。小さくするほど表示はリアルタイムになるが
# サーバーCPU負荷が増える（既定 500）。
# STATS_INTERVAL_MS=500

# メディアフロー監視: 各拠点の上り(サーバー受信)と下り(サーバー送出)のRTPが
# 実際に流れているかを周期確認し、停滞していればセッションを作り直させる自動復旧機構。
# MEDIA_STALL_RECOVERY=0 で無効化。
# MEDIA_STALL_RECOVERY=1
# 監視を実行する周期（既定5000ms）。
# MEDIA_STALL_CHECK_MS=5000
# 受信バイト数が増えないまま何msで「停滞」と判定するか（既定 15000）
# MEDIA_STALL_RESTART_MS=15000
# 同一拠点への再構築指示のクールダウン（既定 60000）
# MEDIA_STALL_COOLDOWN_MS=60000
# 復旧はセッション貼り直しの無限リトライで行い、この時間(ms)連続で復旧しない
# 場合のみクライアントアプリ本体の再起動を指示する（既定 300000 = 5分）
# MEDIA_RECOVERY_RELAUNCH_MS=300000
# ICE disconnectedを一時揺らぎとして待つ時間。超過時はtransportを閉じて再構築（既定20000ms）。
# ICE_DISCONNECTED_CLOSE_MS=20000
# クライアント下り受信が進まないと判定する時間（既定20000ms）。
# CLIENT_RECV_STALL_MS=20000
# consume不足の軽い再同期／session再構築までの時間（既定15000/45000ms）。
# CONSUME_MISSING_NUDGE_MS=15000
# CONSUME_MISSING_REBUILD_MS=45000
# telemetry自動再起動（既定ON）と、未受信／stale／再起動cooldown（ms）。
# TELEMETRY_AUTO_RESTART=1
# TELEMETRY_MISSING_RESTART_MS=45000
# TELEMETRY_STALE_RESTART_MS=90000
# TELEMETRY_RESTART_COOLDOWN_MS=180000
# 予期しない切断後にセッションを仮で残す猶予(ms)。この間、他拠点には
# 「サーバー接続中」と表示され、再接続で同じ拠点として復帰する（既定 300000）
# PEER_DISCONNECT_GRACE_MS=300000
# 接続数/保持セッション/ピア単位メディアの安全上限。
# SFU_MAX_PEERS=200
# SFU_MAX_RETAINED_PEERS=264
# SFU_MAX_PEERS_PER_IP=50
# SFU_MAX_TRANSPORTS_PER_PEER=8
# SFU_MAX_PRODUCERS_PER_PEER=8
# SFU_MAX_CONSUMERS_PER_PEER=512
# サーバー全体のmediasoupネイティブ資源上限（作成中の要求も上限に含む）。
# RTC_PORT使用時のtransport既定上限は1000。動的ポート範囲使用時は、
# 範囲と広告IP数から算出した容量の80%へ自動的に下がります。
# SFU_MAX_TOTAL_TRANSPORTS=1000
# SFU_MAX_TOTAL_PRODUCERS=1000
# SFU_MAX_TOTAL_CONSUMERS=10000
# 更新済みクライアントがtransport作成ACKを受け取り、ローカルtransportを
# 生成したことを返すまでの期限(ms)。ACK喪失の孤児にだけ適用し、
# DTLS未接続で待機中の正常なsend/recv transportは閉じません。
# SFU_TRANSPORT_ACCEPT_TIMEOUT_MS=20000
# 旧名 SFU_TRANSPORT_CONNECT_TIMEOUT_MS も互換のため読み込みます。
# consumer生成ACKが失われた場合に、未resumeの孤児を回収する期限(ms)。
# SFU_CONSUMER_RESUME_TIMEOUT_MS=20000
# SFU_MAX_PENDING_CALLS=256
# SFU_MAX_PENDING_CALLS_PER_PEER=4
# SFU_MAX_PRIVATE_SESSIONS=64
# 1socketのイベントtoken bucket（容量／1秒あたり補充、既定300/30）。
# SFU_SOCKET_RATE_CAPACITY=300
# SFU_SOCKET_RATE_REFILL_PER_SEC=30
# 同一instanceの旧接続を維持する猶予／重複拒否後の再試行抑制（既定15000/60000ms）。
# DUPLICATE_ACTIVE_KEEP_MS=15000
# DUPLICATE_REJECT_RETRY_MS=60000
# mediasoup getStatsが応答しない場合に監視ループを解放する期限(ms)。
# MEDIA_STATS_TIMEOUT_MS=1500
# 外部STUN/TURN(STUN_URLS/TURN_URLS)設定時の死活確認間隔(ms)（既定 60000）
# ICE_PROBE_INTERVAL_MS=60000

# ── サーバー録画 ──────────────────────────────────────────
# 録画設定は recording-settings.json に永続化され、server-gui の設定タブ
# または SFU_ADMIN_TOKEN のBearer認証付きHTTP APIから変更できる。
# 以下は保存先と初期設定。recording-settings.json に対応値がある場合はそちらが優先される。
# 録画データの保存先(NASのマウント先も指定可。例: /Volumes/nas/recordings)
# RECORDINGS_DIR=
# インデックス(データベース)の保存先(未指定なら保存先内の recording-db/)
# RECORDINGS_DB_DIR=
# 取込み中の生セグメントを置くローカル一時保存先。NASは指定しないでください。
# 未指定時は recording-settings.json と同じ場所の recording-staging/、
# server-gui 経由では Electron userData/recording-staging/ を使います。
# RECORDING_STAGING_DIR=./recording-staging
# 初回起動時に録画を有効にする(1/0)
# RECORDING_ENABLED=0
# ffmpeg 実行ファイルのパス(未指定なら PATH と標準的な場所から自動検出)
# FFMPEG_PATH=
# ffprobe 実行ファイルのパス（未指定ならffmpegと同様に自動検出）
# FFPROBE_PATH=
# 録画設定ファイルの場所(server-gui 経由の起動では userData 配下が使われる)
# RECORDING_SETTINGS_FILE=./recording-settings.json

# 以下は録画の負荷/バックプレッシャ上限。起動時に読み込むため、変更後はサーバー再起動が必要です。
# 同時に取り込む録画session数（既定12）。
# RECORDING_MAX_ACTIVE_SESSIONS=12
# 録画用PlainTransport数。未指定時はRTC port rangeから安全値を自動算出します。
# RECORDING_MAX_PLAIN_TRANSPORTS=32
# 確定処理待ち+実行中ジョブ数の上限（既定256）。到達時は新規録画を一時停止します。
# RECORDING_MAX_COMPRESSION_QUEUE=256
# stagingの最低空き容量GB（既定2）。下回ると新規録画を一時停止します。
# RECORDING_MIN_STAGING_FREE_GB=2
# simulcast録画の優先spatial layer（0=低 / 1=中 / 2=高、既定1）。
# RECORDING_SPATIAL_LAYER=1
