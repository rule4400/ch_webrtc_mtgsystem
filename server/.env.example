PORT=3000

# VPN内で全クライアントから到達できるSFUサーバーのIPを指定してください。
# 未指定の場合は自動検出したLAN IPを使いますが、拠点間VPNでは明示指定を推奨します。
ANNOUNCED_IP=

# ファイアウォール/VPNでこのUDP/TCP範囲を通してください。
RTC_MIN_PORT=10000
RTC_MAX_PORT=10200

# L3/VPN拠点で映像が届かない場合は true にすると、
# WebRTCメディア通信を確認済みTCPポートだけに固定します。
FORCE_TCP_MEDIA=false

# VPN経由で到達できるならSTUN/TURNは空で成立します。
# 不安定なNAT越えやUDP制限がある場合はTURNを追加してください。
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_USER=turn-user
# TURN_PASS=turn-password

# デバッグログ。原因調査用にJSONL形式で接続・ICE・RTP統計を保存します。
# 未指定の場合はサーバー実行ディレクトリ配下の logs/ に保存します。
# DEBUG_LOG_DIR=C:\checkhouse-logs
# DEBUG_LOG_DISABLED=false
